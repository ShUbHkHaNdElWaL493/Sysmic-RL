<?xml version="1.0" encoding="utf-8"?>
<!--
  Sysmic V2 pick-and-place scene: robot + 4 utensils on the robot's shelf + a destination table.

  This file is static. SysmicPickPlaceEnv.reset() randomises every pose at runtime without recompiling:
    * utensils (free joints)   -> data.qpos        (row along the shelf, shuffled order / spacing / yaw)
    * table (static body)      -> model.body_pos / model.body_quat (x, y, top height, yaw)
  The poses below are only a valid default (what the viewer shows).
-->
<mujoco model="sysmic_v2_scene">
  <include file="sysmic_v2.xml"/>

  <worldbody>
    <!-- Usable top of the shelf on base_link (static, does not move with the lift). Utensils spawn inside it. -->
    <site name="shelf" type="box" pos="0.175 0 0.496" size="0.0675 0.2275 0.001" rgba="0 1 0 0.3" group="4"/>
    <!-- Invisible collision proxy for the shelf top. MuJoCo collides the base_link mesh as its convex hull,
         which fills the shelf recess, so utensil<->base_link contacts are excluded below and the utensils
         rest on this box instead. Its top face is the shelf surface (z = 0.496). -->
    <geom name="shelf_top" type="box" size="0.0675 0.2275 0.008" pos="0.175 0 0.488" group="3" rgba="0.3 0.3 0.3 1" friction="1 0.005 0.0001"/>

    <!-- Destination table. Body origin = centre of the top surface. Legs are visual only and long enough
         for the highest table (1.05 m); for lower tables they sink below the (opaque) floor. -->
    <body name="table" pos="0.50 0 0.80">
      <geom name="table_top" type="box" size="0.25 0.25 0.02" pos="0 0 -0.02" rgba="0.6 0.45 0.3 1" friction="1 0.005 0.0001"/>
      <geom name="table_leg_fl" type="box" size="0.02 0.02 0.55" pos="0.15 0.19 -0.59" contype="0" conaffinity="0" rgba="0.4 0.3 0.2 1"/>
